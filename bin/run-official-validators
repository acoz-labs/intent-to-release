#!/usr/bin/env bash
set -euo pipefail
codex_root="${CODEX_HOME:-$HOME/.codex}"
plugin_validator="${CODEX_PLUGIN_VALIDATOR:-$codex_root/skills/.system/plugin-creator/scripts/validate_plugin.py}"
skill_validator="${CODEX_SKILL_VALIDATOR:-$codex_root/skills/.system/skill-creator/scripts/quick_validate.py}"
[[ -f "$plugin_validator" && -f "$skill_validator" ]] || { echo "official creator validators not found; set CODEX_PLUGIN_VALIDATOR and CODEX_SKILL_VALIDATOR" >&2; exit 1; }
command -v uv >/dev/null || { echo "uv is required for ephemeral PyYAML validation" >&2; exit 1; }
uv run --with pyyaml python3 "$plugin_validator" plugins/intent-to-release
for skill in plugins/intent-to-release/skills/*; do uv run --with pyyaml python3 "$skill_validator" "$skill"; done
